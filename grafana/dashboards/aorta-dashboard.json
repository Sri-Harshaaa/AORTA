      "targets": [ { "refId": "A", "expr": "aorta_lb_healthy_backends" } ],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 2 }, { "color": "green", "value": 3 } ] } }
      },
      "options": { "reduceOptions": { "calcs": [ "lastNotNull" ] }, "graphMode": "none", "colorMode": "value" }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "FAILOVERS",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "aorta-prometheus" },
      "targets": [ { "refId": "A", "expr": "sum(aorta_lb_backend_failovers)" } ],
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 } ] } }
      },
      "options": { "reduceOptions": { "calcs": [ "lastNotNull" ] }, "graphMode": "none", "colorMode": "value" }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Global Throughput",
      "gridPos": { "x": 0, "y": 4, "w": 14, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "aorta-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(aorta_requests_total[1m]))", "legendFormat": "Requests" },
        { "refId": "B", "expr": "sum(rate(aorta_responses_total[1m]))", "legendFormat": "Responses" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 15, "gradientMode": "opacity", "lineWidth": 2, "spanNulls": true } }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
