    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "options": {
        "mode": "markdown",
        "content": "### AORTA\n**Distributed systems observability**\n\nTCP Load Balancer\n3 HTTP Backends"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "REQUEST RATE",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "aorta-prometheus" },
      "targets": [ { "refId": "A", "expr": "sum(rate(aorta_requests_total[1m]))" } ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 25000 }, { "color": "red", "value": 50000 } ] } }
      },
      "options": { "reduceOptions": { "calcs": [ "lastNotNull" ] }, "graphMode": "area", "colorMode": "value", "textMode": "auto" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "ERROR RATE",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "aorta-prometheus" },
      "targets": [ { "refId": "A", "expr": "100 * sum(rate(aorta_errors_total[1m])) / clamp_min(sum(rate(aorta_requests_total[1m])), 0.001)" } ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "decimals": 2, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 } ] } }
      },
      "options": { "reduceOptions": { "calcs": [ "lastNotNull" ] }, "graphMode": "area", "colorMode": "value" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "LB CONNECTIONS",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "aorta-prometheus" },
      "targets": [ { "refId": "A", "expr": "aorta_lb_active_connections" } ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "text" } } },
      "options": { "reduceOptions": { "calcs": [ "lastNotNull" ] }, "graphMode": "area", "colorMode": "value" }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "HEALTHY BACKENDS",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
