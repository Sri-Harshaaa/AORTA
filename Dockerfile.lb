FROM debian:bookworm AS builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY . .

RUN cmake -S . -B build -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build --target aorta_lb -j"$(nproc)"

FROM debian:bookworm-slim

WORKDIR /app

COPY --from=builder /app/build/aorta_lb /app/aorta_lb

# Baked in so the image runs standalone; docker-compose bind-mounts over it.
COPY --from=builder /app/config /app/config

EXPOSE 9000

ENTRYPOINT ["/app/aorta_lb"]